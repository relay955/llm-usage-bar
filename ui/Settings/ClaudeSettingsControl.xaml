<UserControl x:Class="LLMUsageBar.ui.ClaudeSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="180"
             d:DesignWidth="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Claude 사용"
                   Foreground="#FFE8E8E8"
                   FontSize="13"
                   VerticalAlignment="Center" />
        <CheckBox Grid.Row="0"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  IsChecked="{Binding PendingAppSettings.UseClaude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,16,0,0"
                   Text="Desktop 데이터 폴더"
                   Foreground="#FFE8E8E8"
                   FontSize="13"
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,16,0,0"
                 Height="30"
                 VerticalContentAlignment="Center"
                 Padding="8,0"
                 ToolTip="비워두면 자동으로 탐색합니다. 직접 지정할 때는 config.json과 Local State가 있는 폴더를 입력하세요."
                 Text="{Binding PendingAppSettings.ClaudeDesktopDataDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Margin="0,16,0,0"
                   Text="Claude Desktop에서 로그인한 계정의 5시간 및 주간 잔여 사용량을 표시합니다. 폴더 경로를 비워두면 자동으로 탐색합니다. 인증이 만료되면 Claude Desktop을 열어 다시 로그인해주세요."
                   Foreground="#FF9CA3AF"
                   FontSize="12"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
