<UserControl x:Class="LLMUsageBar.ui.ProviderPickerControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="0"
             Height="0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Focusable="False">
    <Popup x:Name="ProviderPopup"
           PlacementTarget="{Binding PlacementTarget, ElementName=Root}"
           Placement="Top"
           AllowsTransparency="True"
           StaysOpen="True"
           DataContext="{Binding ElementName=Root}">
        <Border x:Name="PopupBorder"
                Width="{Binding PlacementTarget.ActualWidth, ElementName=ProviderPopup}"
                Background="#FAFAFA"
                BorderBrush="#CDCDCD"
                BorderThickness="1"
                CornerRadius="4,4,0,0"
                Padding="4"
                MouseEnter="Popup_MouseEnter"
                MouseLeave="ProviderArea_MouseLeave"
                Button.Click="Popup_Click"
                PreviewKeyDown="Popup_PreviewKeyDown">
            <ScrollViewer MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ProviderItems" ItemsSource="{Binding ItemsSource}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#353535" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="Padding" Value="10,7" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#DDEBFA" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E5E5E5" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Background" Value="#E5E5E5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Popup>
</UserControl>
